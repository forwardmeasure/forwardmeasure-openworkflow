    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <proc>full</proc>
                        <parameters>true</parameters>
                        <showWarnings>true</showWarnings>
                        <compilerArgs>
                            <arg>-Xlint:all,-processing</arg>
                            <arg>-Werror</arg>
                        </compilerArgs>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.hibernate.orm</groupId>
                                <artifactId>hibernate-processor</artifactId>
                                <version>${hibernate.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.rat</groupId>
                    <artifactId>apache-rat-plugin</artifactId>
                    <version>${apache.rat.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.basepom.maven</groupId>
                    <artifactId>duplicate-finder-maven-plugin</artifactId>
                    <version>${duplicate.finder.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <openworkflow.specification.version>${openworkflow.specification.version}</openworkflow.specification.version>
                            <serverlessworkflow.schema.sha256>${serverlessworkflow.schema.sha256}</serverlessworkflow.schema.sha256>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-reproducible-build</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration>
                    <flattenMode>ossrh</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.rat</groupId>
                <artifactId>apache-rat-plugin</artifactId>
                <configuration>
                    <inputExcludes>
                        <inputExclude>.git/**</inputExclude>
                        <inputExclude>.gitignore</inputExclude>
                        <inputExclude>.mvn/**</inputExclude>
                        <inputExclude>mvnw</inputExclude>
                        <inputExclude>mvnw.cmd</inputExclude>
                        <inputExclude>**/*.md</inputExclude>
                        <!-- Exact Apache-2.0 upstream conformance fixtures; integrity is SHA-pinned. -->
                        <inputExclude>**/official-v1.0.3/**</inputExclude>
                        <inputExclude>config/keycloak/*.json</inputExclude>
                        <inputExclude>docs/diagrams/**</inputExclude>
                        <!-- Helm chart metadata and generated bootstrap CQL are distribution assets. -->
                        <inputExclude>deploy/helmfile/helmfiles/studios.yaml.gotmpl</inputExclude>
                        <inputExclude>deploy/helmfile/releases/openworkflow-foundation/files/cassandra-schema.cql</inputExclude>
                        <inputExclude>deploy/helmfile/releases/openworkflow-foundation/templates/cassandra.yaml</inputExclude>
                        <inputExclude>deploy/helmfile/releases/openworkflow-foundation/templates/redpanda.yaml</inputExclude>
                        <inputExclude>deploy/helmfile/releases/openworkflow-kafka-runtime/**</inputExclude>
                        <inputExclude>deploy/helmfile/releases/openworkflow-pekko-runtime/Chart.yaml</inputExclude>
                        <inputExclude>deploy/helmfile/releases/openworkflow-pekko-runtime/values.yaml</inputExclude>
                        <inputExclude>deploy/helmfile/releases/openworkflow-studio/**</inputExclude>
                        <!-- Maven-managed frontend dependencies and build/test output. -->
                        <inputExclude>**/node_modules/**</inputExclude>
                        <inputExclude>**/build/**</inputExclude>
                        <inputExclude>**/test-results/**</inputExclude>
                        <inputExclude>**/.prettierignore</inputExclude>
                        <inputExclude>config/openapi/templates/typescript-fetch/package.mustache</inputExclude>
                        <inputExclude>**/target/**</inputExclude>
                    </inputExcludes>
                </configuration>
                <executions>
                    <execution>
                        <id>license-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.basepom.maven</groupId>
                <artifactId>duplicate-finder-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>duplicate-class-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <failBuildInCaseOfConflict>true</failBuildInCaseOfConflict>
                            <checkTestClasspath>true</checkTestClasspath>
                            <ignoredResourcePatterns>
                                <ignoredResourcePattern>about.html</ignoredResourcePattern>
                                <!-- Pekko/Typesafe configuration is intentionally additive across jars. -->
                                <ignoredResourcePattern>reference.conf</ignoredResourcePattern>
                                <!-- Pekko shades protobuf descriptors also supplied by the gRPC runtime. -->
                                <ignoredResourcePattern>google/protobuf/.*\.proto</ignoredResourcePattern>
                                <!-- Eclipse Paho MQTT v3/v5 publish the same OSGi localization resource. -->
                                <ignoredResourcePattern>bundle.properties</ignoredResourcePattern>
                                <!-- HTTP clients embed independent snapshots of the public-suffix list. -->
                                <ignoredResourcePattern>org/publicsuffix/list/effective_tld_names.dat</ignoredResourcePattern>
                                <ignoredResourcePattern>.*META-INF/.*</ignoredResourcePattern>
                            </ignoredResourcePatterns>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>focused</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <properties>
                <skipITs>true</skipITs>
            </properties>
        </profile>
        <profile>
            <id>capability-gate</id>
            <properties>
                <skipITs>false</skipITs>
            </properties>
        </profile>
        <profile>
            <id>full-suite</id>
            <properties>
                <skipITs>false</skipITs>
                <fullSuite>true</fullSuite>
            </properties>
        </profile>
    </profiles>
</project>
