    <properties>
        <revision>1.0.0-SNAPSHOT</revision>

        <!-- Locked product-foundation versions. -->
        <openworkflow.specification.version>1.0.3</openworkflow.specification.version>
        <serverlessworkflow.sdk.version>7.29.0.Final</serverlessworkflow.sdk.version>
        <serverlessworkflow.schema.sha256>
            e0cfa77227a9b537be7519041683508151e21dc80aa991dfbf6362dfc36b2331</serverlessworkflow.schema.sha256>
        <forwardmeasure.jpa.version>1.0.0</forwardmeasure.jpa.version>
        <forwardmeasure.testcontainers.version>1.0.0</forwardmeasure.testcontainers.version>

        <!-- Every deployable leaf owns container-image.name; coordinates and switches are inherited. -->
        <container-image.tag>${project.version}</container-image.tag>

        <!-- Shared library versions. -->
        <archunit.version>1.4.1</archunit.version>
        <jackson.jq.version>1.6.2</jackson.jq.version>
        <json.schema.validator.version>2.0.4</json.schema.validator.version>
        <liquibase.cassandra.version>5.0.3</liquibase.cassandra.version>
        <!-- Product-specific quality plugins not owned by the shared Java parent. -->
        <apache.rat.version>0.17</apache.rat.version>
        <duplicate.finder.version>2.0.1</duplicate.finder.version>

        <!-- Product-wide aggregate coverage contract. -->
        <jacoco.minimum.line.coverage>0.85</jacoco.minimum.line.coverage>
        <jacoco.minimum.branch.coverage>0.75</jacoco.minimum.branch.coverage>
        <jacoco.maximum.missed.classes>0</jacoco.maximum.missed.classes>
    </properties>

