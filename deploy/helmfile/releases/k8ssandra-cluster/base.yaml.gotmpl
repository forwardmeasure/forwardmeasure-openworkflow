# Only overrides name/clusterName - data-fabric-cluster-helm-chart's own
# defaults (data-fabric/dc1/size 3, resources, reaper) come from
# data-fabric's own real, working deployment and are left as-is rather than
# re-guessed. The chart's default `name: data-fabric` /
# `cassandra.clusterName: data-fabric` must be overridden here though - it's
# data-fabric-specific, not a generic default, and directly determines the
# auto-created service/secret names OpenWorkflow's own coordinates below
# depend on (openworkflow-dc1-service, openworkflow-superuser).
name: openworkflow
cassandra:
  clusterName: openworkflow
