deploymentProfile: development
imagePullPolicy: IfNotPresent
# Layered on environments/gcp.yaml (see helmfile.yaml.gotmpl) - this profile
# always targets an already-provisioned cluster (forwardmeasure-platform or
# equivalent), never a genuinely standalone one. That's what makes
# ingressEnabled: true safe here: routing.yaml.gotmpl's $cloud=="gcp" gate
# attaches to the existing platform Gateway instead of creating a
# self-contained one, so this doesn't depend on istio/cert-manager being
# installed by this repo (it no longer is, for any environment).
ingressEnabled: true
# Shared with production - real Cloud DNS zone/Let's Encrypt certs, not a
# per-environment value, so it isn't hardcoded here.
gcpProjectId: {{ requiredEnv "OPENWORKFLOW_GCP_PROJECT_ID" | quote }}
operations:
  httpEgressAllowlist: ""
definitionResources:
  allowedHosts: ""
hardening:
  networkPolicyEnabled: false
telemetry:
  otlpEndpoint: "http://otel-collector:4317"
