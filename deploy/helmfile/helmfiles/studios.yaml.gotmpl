helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 600
  atomic: true

releases:
{{- /*
Pinned to workflowPlatformFramework, not all 3 - see execution-engines.yaml.gotmpl's
identical comment for why.
*/}}
{{- range $framework := list $.Values.workflowPlatformFramework }}
  - name: openworkflow-studio-{{ $framework }}
    namespace: {{ $.Values.openworkflowNamespace }}
    chart: ../releases/openworkflow-studio
    values:
      - framework: {{ $framework }}
        image:
          repository: {{ index $.Values.imageVersions.studio.repositories $framework | quote }}
          tag: {{ $.Values.imageVersions.studio.tag | quote }}
          digest: {{ index $.Values.imageVersions.studio.digests $framework | quote }}
          pullPolicy: {{ $.Values.imagePullPolicy }}
        apiUpstream: http://openworkflow-definition-management-{{ $framework }}:8080
        environmentName: Kind acceptance
        replicas: {{ dig "replicas" "studio" 1 $.Values }}
        networkPolicy:
          enabled: {{ dig "hardening" "networkPolicyEnabled" false $.Values }}
          {{- with (dig "networkPolicy" "externalEgressCidr" "" $.Values) }}
          extraEgress:
            - to: [{ipBlock: {cidr: {{ . | quote }}}}]
          {{- end }}
        telemetry:
          otlpEndpoint: {{ dig "telemetry" "otlpEndpoint" "" $.Values | quote }}
          injectJava: {{ dig "telemetry" "injectJava" false $.Values }}
        ingress:
          enabled: {{ $.Values.ingressEnabled }}
          className: nginx
          host: openworkflow-{{ $framework }}.local
    labels:
      stage: studio
      checkpoint: K4
      framework: {{ $framework }}
{{- end }}
