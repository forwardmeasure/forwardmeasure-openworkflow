releases:
{{- range $framework := list "quarkus" "spring" "micronaut" }}
  - name: openworkflow-studio-{{ $framework }}
    namespace: {{ $.Values.openworkflowNamespace }}
    chart: ../releases/openworkflow-studio
    values:
      - framework: {{ $framework }}
        image:
          repository: forwardmeasure/openworkflow-studio-{{ $framework }}
          tag: {{ $.Values.studioVersion | quote }}
          pullPolicy: {{ $.Values.imagePullPolicy }}
        apiUpstream: http://openworkflow-definition-{{ $framework }}:8080
        environmentName: Kind acceptance
        replicas: {{ dig "replicas" "studio" 1 $.Values }}
        networkPolicy:
          enabled: {{ dig "hardening" "networkPolicyEnabled" false $.Values }}
          {{- with (dig "networkPolicy" "externalEgressCidr" "" $.Values) }}
          extraEgress:
            - to: [{ipBlock: {cidr: {{ . | quote }}}}]
          {{- end }}
        telemetry:
          otlpEndpoint: {{ dig "telemetry" "otlpEndpoint" "" $.Values | quote }}
          injectJava: {{ dig "telemetry" "injectJava" false $.Values }}
        ingress:
          enabled: {{ $.Values.ingressEnabled }}
          className: nginx
          host: openworkflow-{{ $framework }}.local
    labels:
      checkpoint: K4
      framework: {{ $framework }}
{{- end }}
