helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 600
  atomic: true

releases:
{{- /*
Pinned to workflowPlatformFramework, not all 3 - see execution-engines.yaml.gotmpl's
identical comment for why.
*/}}
{{- /*
Which pekko flavor OPENWORKFLOW_PEKKO_ENGINE_URL points at when both
engines.pekkoPostgresql and engines.pekkoCassandra are enabled - since
execution-engines.yaml.gotmpl split the old single "pekko" release into
independent pekko-postgresql/pekko-cassandra releases (both can now run
simultaneously), this one URL can no longer unambiguously mean "the pekko
engine". Reproduces the exact prior behavior (cassandra wins when
pekkoCassandra is true) as a placeholder, same as
ExecutionEngineSelector/OPENWORKFLOW_DEFAULT_ENGINE below - real per-
execution engine routing (which pekko flavor, not just kafka-streams vs
pekko) is a separate, not-yet-built piece of work, not something decided
here.
*/}}
{{- $pekkoDefaultEngine := ternary "pekko-cassandra" "pekko-postgresql" (dig "engines" "pekkoCassandra" false .Values) }}
{{- $defaultEngine := dig "engines" "default" "kafka-streams" .Values }}
{{- /*
Fail at render time, not at runtime, if OPENWORKFLOW_DEFAULT_ENGINE would
point execution traffic at an engine that isn't actually deployed -
confirmed the hard way this was previously possible: every combination of
engines.* flags rendered and deployed cleanly, including all-false, leaving
execution-management pointed at a Service that doesn't exist and every
execution failing at connection time instead of at deploy time.
*/}}
{{- if and (eq $defaultEngine "kafka-streams") (not (dig "engines" "kafkaStreams" true .Values)) }}
{{- fail "engines.default is \"kafka-streams\" but engines.kafkaStreams is false - OPENWORKFLOW_DEFAULT_ENGINE would point at a Service that doesn't exist." }}
{{- end }}
{{- if and (ne $defaultEngine "kafka-streams") (not (or (dig "engines" "pekkoPostgresql" true .Values) (dig "engines" "pekkoCassandra" false .Values))) }}
{{- fail "engines.default selects pekko but neither engines.pekkoPostgresql nor engines.pekkoCassandra is true - OPENWORKFLOW_DEFAULT_ENGINE would point at a Service that doesn't exist." }}
{{- end }}
{{- range $framework := list $.Values.workflowPlatformFramework }}
  - name: openworkflow-execution-management-{{ $framework }}
    namespace: {{ $.Values.openworkflowNamespace }}
    chart: ../releases/openworkflow-service
    values:
      - name: openworkflow-execution-management-{{ $framework }}
        capability: execution-management
        framework: {{ $framework }}
        replicas: {{ dig "replicas" "executionManagement" 1 $.Values }}
        image:
          repository: {{ index $.Values.imageVersions.executionManagement.repositories $framework | quote }}
          tag: {{ $.Values.imageVersions.executionManagement.tag | quote }}
          digest: {{ index $.Values.imageVersions.executionManagement.digests $framework | quote }}
          pullPolicy: {{ $.Values.imagePullPolicy }}
        env:
          - {name: OPENWORKFLOW_DATABASE_URL, value: {{ dig "database" "url" "jdbc:postgresql://postgresql:5432/openworkflow" $.Values | quote }}}
          - {name: OPENWORKFLOW_DATABASE_USERNAME, value: {{ dig "database" "username" "openworkflow" $.Values | quote }}}
          - {name: OPENWORKFLOW_KEYCLOAK_ISSUER, value: {{ dig "keycloak" "issuer" "http://keycloak:8080/realms/openworkflow" $.Values | quote }}}
          - {name: OPENWORKFLOW_KAFKA_ENGINE_URL, value: {{ printf "http://openworkflow-engine-kafka-streams-%s:8080/internal/v1/engine/" $framework | quote }}}
          - {name: OPENWORKFLOW_PEKKO_ENGINE_URL, value: {{ printf "http://openworkflow-engine-%s-%s:8080/internal/v1/engine/" $pekkoDefaultEngine $framework | quote }}}
          # ExecutionEngineSelector currently just returns this constant for
          # every execution (no real per-tenant/per-definition policy exists
          # yet) - both engine deployments (engines.kafkaStreams/
          # pekkoPostgresql/pekkoCassandra) can be installed at once, but only
          # this one ever receives real execution traffic. Previously never
          # set here at all, silently falling back to the Java default
          # (kafka-streams) with no way to override it from values - "kafka-streams"
          # kept as the same default so omitting engines.default changes nothing.
          - {name: OPENWORKFLOW_DEFAULT_ENGINE, value: {{ dig "engines" "default" "kafka-streams" $.Values | quote }}}
        secretEnv:
          - {name: OPENWORKFLOW_DATABASE_PASSWORD, valueFrom: {secretKeyRef: {name: {{ dig "credentialsSecretName" "openworkflow-foundation" $.Values | quote }}, key: OPENWORKFLOW_DATABASE_PASSWORD}}}
          - {name: OPENWORKFLOW_CLIENT_SECRET, valueFrom: {secretKeyRef: {name: {{ dig "credentialsSecretName" "openworkflow-foundation" $.Values | quote }}, key: OPENWORKFLOW_CLIENT_SECRET}}}
        cloudSqlProxy:
          enabled: {{ dig "cloudSqlProxy" "enabled" false $.Values }}
          instanceConnectionName: {{ dig "cloudSqlProxy" "instanceConnectionName" "" $.Values | quote }}
          image:
            repository: {{ $.Values.imageVersions.cloudSqlProxy.repository | quote }}
            tag: {{ $.Values.imageVersions.cloudSqlProxy.tag | quote }}
            digest: {{ $.Values.imageVersions.cloudSqlProxy.digest | quote }}
        {{- if dig "cloudSqlProxy" "enabled" false $.Values }}
        serviceAccount: {create: false, name: openworkflow-runtime, automount: true}
        {{- end }}
    labels: {stage: execution, capability: execution-management, framework: {{ $framework }}}
{{- end }}
