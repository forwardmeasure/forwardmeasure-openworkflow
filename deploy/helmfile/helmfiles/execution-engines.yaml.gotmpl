releases:
  - name: openworkflow-pekko-postgresql
    namespace: {{ .Values.openworkflowNamespace }}
    chart: ../releases/openworkflow-pekko-runtime
    installed: {{ dig "engines" "pekkoPostgresql" true .Values }}
    values:
      - ../releases/openworkflow-pekko-runtime/base.yaml.gotmpl
      - name: openworkflow-pekko-postgresql
        persistence:
          profile: postgresql
          endpoint: {{ dig "pekko" "postgresqlEndpoint" "jdbc:postgresql://postgresql:5432/openworkflow?currentSchema=t_11111111111111111111111111111111" .Values | quote }}
    labels:
      stage: execution
      checkpoint: K3A
      persistence: postgresql
  - name: openworkflow-pekko-cassandra
    namespace: {{ .Values.openworkflowNamespace }}
    chart: ../releases/openworkflow-pekko-runtime
    installed: {{ dig "engines" "pekkoCassandra" true .Values }}
    values:
      - ../releases/openworkflow-pekko-runtime/base.yaml.gotmpl
      - name: openworkflow-pekko-cassandra
        persistence:
          profile: cassandra
          endpoint: {{ dig "pekko" "cassandraEndpoint" "cassandra:9042" .Values | quote }}
          username: ""
          password: ""
          localDatacenter: {{ dig "pekko" "cassandraLocalDatacenter" "datacenter1" .Values | quote }}
    labels:
      stage: execution
      checkpoint: K3A
      persistence: cassandra
  - name: openworkflow-kafka
    namespace: {{ .Values.openworkflowNamespace }}
    chart: ../releases/openworkflow-kafka-runtime
    installed: {{ dig "engines" "kafkaStreams" true .Values }}
    values:
      - ../releases/openworkflow-kafka-runtime/base.yaml.gotmpl
    labels:
      stage: execution
      checkpoint: K3B
      engine: kafka-streams
