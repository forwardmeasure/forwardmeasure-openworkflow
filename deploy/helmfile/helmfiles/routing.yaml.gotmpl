helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 600
  atomic: true

{{- $cloud := .Values | get "cloudProvider" "" }}

# OpenWorkflow's own public HTTPRoutes for platformTld (studio, definitions,
# execution). Only relevant where a real public domain points at the cluster
# - gated on ingressEnabled.
#
# On a real cloud cluster ($cloud set), these routes attach to
# forwardmeasure-platform's own shared Gateway (its platform-routing
# release already has a wildcard `tenant-https` listener, backed by a real
# wildcard cert - `*.{{ .Values.platformTld }}` matches it exactly) instead
# of creating a second, competing Gateway. Two independent public Gateways
# in istio-system meant two separate LoadBalancer IPs and two separate
# ClusterIssuers doing the identical GCP DNS-01 solve for one cluster,
# confirmed via real values comparison this session.
#
# Standalone clusters (local/ci/kind, $cloud unset) still default to
# gateway.enabled: true (their own self-contained Gateway), addressed into
# istioSystemNamespace and annotated with letsencryptClusterIssuerName -
# both of which this repo no longer installs itself (see
# helmfiles/core-infrastructure.yaml.gotmpl). None of the three currently
# set ingressEnabled: true, so this fallback path is not exercised by any
# registered environment today - confirmed via helmfile.yaml.gotmpl's
# environments: block, not just this file's own defaults.
#
# "development" looks like a standalone/$cloud-unset profile by name, but
# isn't: helmfile.yaml.gotmpl layers environments/gcp.yaml under
# development.yaml.gotmpl, so cloudProvider is "gcp" there too, and it takes
# the safe attach-to-platform-gateway path above, same as
# gcp-openworkflow-prod and production-multi-engine (both layer gcp.yaml the
# same way). Verified directly: `helmfile -e development template
# --selector stage=routing` renders zero standalone Gateway objects, only
# HTTPRoutes parented to platform-gateway.
releases:
{{ if .Values.ingressEnabled }}
  - name: openworkflow-gateway
    namespace: {{ .Values.istioSystemNamespace }}
    chart: ../charts/openworkflow-gateway
    missingFileHandler: Error
    labels: {stage: routing}
    values:
      - platformTld: {{ .Values.platformTld }}
        istioSystemNamespace: {{ .Values.istioSystemNamespace }}
        openworkflowNamespace: {{ .Values.openworkflowNamespace }}
        workflowPlatformFramework: {{ .Values.workflowPlatformFramework }}
        {{- if eq $cloud "gcp" }}
        gateway:
          enabled: false
          # forwardmeasure-platform's platform-routing release - name and
          # wildcard listener name are fixed conventions there, not
          # per-environment values (confirmed: never overridden across any
          # of its registered environments).
          name: platform-gateway
          namespace: {{ .Values.istioSystemNamespace }}
          sectionName: tenant-https
        {{- end }}
{{ end }}
