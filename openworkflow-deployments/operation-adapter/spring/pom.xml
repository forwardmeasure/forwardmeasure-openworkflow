<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.forwardmeasure.openworkflow</groupId>
    <artifactId>openworkflow-deployments</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>openworkflow-operation-adapter-spring</artifactId>
  <name>ForwardMeasure OpenWorkflow :: Operation Adapter :: Spring</name>
  <properties>
    <container-image.name>openworkflow-operation-adapter-spring</container-image.name>
  </properties>
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-authorization-authzen</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-operation-adapter-kafka</artifactId>
      <exclusions>
        <exclusion>
          <groupId>jakarta.el</groupId>
          <artifactId>jakarta.el-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-operation-adapter-pekko</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
    Classic Spring Boot Test collision, confirmed via duplicate-finder-maven-plugin's real output
    and dependency:tree: spring-boot-starter-test -> jsonassert pulls both
    com.vaadin.external.google:android-json (a same-API clone of org.json's classes, duplicating
    org.json.JSONArray/JSONObject/etc.) AND bundles its own org.json.JSONString directly inside
    jsonassert's own jar (confirmed via direct jar inspection - not a transitive artifact, so a
    <exclusion> on android-json alone can't remove it). This module has a REAL org.json:json (via
    openworkflow-operation-adapter-kafka -> openworkflow-operation-adapter-asyncapi-jms ->
    com.ibm.mq:com.ibm.mq.allclient, compile scope). Excluding jsonassert entirely rather than
    picking at each sub-collision - confirmed via repo-wide grep that no test anywhere in this
    module uses JSONAssert, so it's pure unused baggage pulled in by spring-boot-starter-test's own
    defaults, not something this module needs.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.skyscreamer</groupId>
          <artifactId>jsonassert</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-redpanda</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>container-image</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <configuration>
              <images>
                <image>
                  <name>${container-image.registry}/${container-image.group}/${container-image.name}:${container-image.tag}</name>
                  <build>
                    <contextDir>${project.basedir}</contextDir>
                    <dockerFile>src/main/docker/Dockerfile.jvm</dockerFile>
                    <args>
                      <APPLICATION_JAR>target/${project.build.finalName}.jar</APPLICATION_JAR>
                      <BASE_IMAGE>${container-image.base-jre}</BASE_IMAGE>
                    </args>
                  </build>
                </image>
              </images>
            </configuration>
            <executions>
              <execution>
                <id>build-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>build</goal>
                </goals>
              </execution>
              <execution>
                <id>push-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>push</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
