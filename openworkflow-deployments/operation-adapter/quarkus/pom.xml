<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.forwardmeasure.openworkflow</groupId>
    <artifactId>openworkflow-deployments</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
 
  <artifactId>openworkflow-operation-adapter-quarkus</artifactId>
   <name>ForwardMeasure OpenWorkflow :: Operation Adapter :: Quarkus</name>

  <properties>
    <container-image.name>openworkflow-operation-adapter-quarkus</container-image.name>
  </properties>
 
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-authorization-authzen</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-operation-adapter-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-operation-adapter-pekko</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-config-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.annotation.bundle</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.codehaus.plexus</groupId>
          <artifactId>plexus-utils</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!--
    quarkus-junit's own exclusion above strips the old, colliding transitive plexus-utils copies -
    quarkus-bom itself excludes plexus-utils from several of its own managed dependencies for the
    same reason. This module's @QuarkusTest + @QuarkusTestResource(KafkaAdapterResource) actually
    exercises Quarkus's real Maven-resolver-based "curated application" bootstrap (unlike the
    engine-pekko/engine-kafka-streams Quarkus tests, which call binding methods directly and never
    trigger it) - that bootstrap needs org.apache.maven.graph.DefaultGraphBuilder, which needs
    org.codehaus.plexus.util.dag.CycleDetectedException, a real plexus-utils class. Without this
    explicit re-add, plexus-utils is excluded from every path and the bootstrap fails with
    NoClassDefFoundError instead of ever starting the test.

    Pinned to 4.0.3, NOT the quarkus-bom-managed 3.6.1: something else in Quarkus's own bootstrap
    dependency graph independently pulls org.codehaus.plexus:plexus-xml:4.0.2 (confirmed via
    duplicate-finder-maven-plugin's real output - not assumed), a newer artifact that split
    plexus-utils's org.codehaus.plexus.util.xml.* classes out into their own jar. plexus-utils:3.6.1
    still bundles that same xml.* package, so it collides with plexus-xml as "duplicate and
    different" classes (9 of them, including Xpp3Dom) and fails duplicate-class-check. Confirmed via
    direct jar inspection: plexus-utils:4.0.3 has already had the xml.* package fully removed
    (matching the plexus-xml split) while still containing dag.CycleDetectedException - the one
    class actually needed here - so it coexists with plexus-xml cleanly.
    -->
    <dependency>
      <groupId>org.codehaus.plexus</groupId>
      <artifactId>plexus-utils</artifactId>
      <version>4.0.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-redpanda</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>container-image</id>
      <build>
        <plugins>
          <!--
          fabric8 docker-maven-plugin, not Quarkus's own quarkus-container-image-docker - same
          mechanism as every non-Quarkus openworkflow module (tenant-provisioning, migrations,
          spring/micronaut service bindings). Declared after quarkus-maven-plugin in this pom's
          own <build><plugins> (Maven appends a profile's <plugins> after the base build's, for
          same-phase executions) so this always builds from target/quarkus-app/ (produced by
          quarkus-maven-plugin's own build goal, also bound to the package phase) after Quarkus's
          augmentation has already run, not before it.
          -->
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <configuration>
              <images>
                <image>
                  <name>${container-image.registry}/${container-image.group}/${container-image.name}:${container-image.tag}</name>
                  <build>
                    <contextDir>${project.basedir}</contextDir>
                    <dockerFile>src/main/docker/Dockerfile.jvm</dockerFile>
                  </build>
                </image>
              </images>
            </configuration>
            <executions>
              <execution>
                <id>build-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>build</goal>
                </goals>
              </execution>
              <execution>
                <id>push-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>push</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
