<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.forwardmeasure.openworkflow</groupId>
    <artifactId>openworkflow-deployments</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>openworkflow-engine-kafka-streams-spring</artifactId>
  <name>ForwardMeasure OpenWorkflow :: Engine Kafka Streams :: Spring</name>
  <properties>
    <container-image.name>openworkflow-engine-kafka-streams-spring</container-image.name>
  </properties>
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-kafka-streams-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-kafka-streams-engine-jaxrs</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-engine-http</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-engine-http-server</artifactId>
    </dependency>
    <!--
      Gives ActiveOrganizationProvider (SpringActiveOrganizationProvider) and the Spring Security
      JWT resource-server filter chain - same shared module openworkflow-engine-pekko-spring already
      depends on for CloudEventIngressResource's identical authorization needs. No Pekko on this
      module's classpath, so (unlike engine-pekko/spring) no osgi/jakarta.el exclusions are needed -
      those exclusions guard against a SECOND source of the same classes colliding, and this module
      has no second source.
    -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-spring-binding</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      openworkflow-spring-binding's own jakarta.enterprise.cdi-api is provided-scope, so it does not
      propagate here (provided is non-transitive). Without it present at all, hibernate-processor
      (globally registered, root pom.xml) cannot resolve jakarta.enterprise.context.NormalScope's
      classfile while processing this module's sources and emits a -Werror-fatal warning
      ("class file for NormalScope not found") - this module is the first Spring binding consumer
      with zero other source of jakarta.enterprise.cdi-api on its classpath (engine-pekko/spring
      already carries this exact dependency directly, for the same reason). Mirrors that module's
      declaration exactly, including the jakarta.el-api exclusion (cdi-api pulls it transitively for
      its own EL-based bean resolution; Spring Boot's embedded Tomcat already provides a complete,
      compatible EL implementation).
    -->
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>jakarta.enterprise.cdi-api</artifactId>
      <scope>provided</scope>
      <exclusions>
        <exclusion><groupId>jakarta.el</groupId><artifactId>jakarta.el-api</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jersey</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.glassfish.hk2.external</groupId>
          <artifactId>aopalliance-repackaged</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>container-image</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <configuration>
              <images>
                <image>
                  <name>
                    ${container-image.registry}/${container-image.group}/${container-image.name}:${container-image.tag}</name>
                  <build>
                    <contextDir>${project.basedir}</contextDir>
                    <dockerFile>src/main/docker/Dockerfile.jvm</dockerFile>
                    <args>
                      <APPLICATION_JAR>target/${project.build.finalName}.jar</APPLICATION_JAR>
                      <BASE_IMAGE>${container-image.base-jre}</BASE_IMAGE>
                    </args>
                  </build>
                </image>
              </images>
            </configuration>
            <executions>
              <execution>
                <id>build-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>build</goal>
                </goals>
              </execution>
              <execution>
                <id>push-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>push</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>