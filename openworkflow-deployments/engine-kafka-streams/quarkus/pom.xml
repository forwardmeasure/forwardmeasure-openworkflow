<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.forwardmeasure.openworkflow</groupId>
    <artifactId>openworkflow-deployments</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>openworkflow-engine-kafka-streams-quarkus</artifactId>

  <name>ForwardMeasure OpenWorkflow :: Engine Kafka Streams :: Quarkus</name>

  <properties>
    <container-image.name>openworkflow-engine-kafka-streams-quarkus</container-image.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-kafka-streams-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-kafka-streams-engine-jaxrs</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-engine-http</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-engine-http-server</artifactId>
    </dependency>
    <!--
      Gives TenantScope/EntityManagerFactory (forwardmeasure-jpa-quarkus + quarkus-hibernate-orm),
      ActiveOrganizationProvider (QuarkusActiveOrganizationProvider), and AuthorizationService
      (openworkflow-authorization-authzen) - same shared module openworkflow-engine-pekko-quarkus
      already depends on for CloudEventIngressResource's identical authorization needs. This engine
      has no other use for JPA/Hibernate; it comes along only because ActiveOrganizationProvider
      lives in the same module.

      Excludes org.osgi:osgi.annotation: hibernate-jcache -> caffeine -> jcache pulls the old,
      combined 8.1.0 jar, while this module's own pre-existing direct org.osgi.annotation.bundle
      dependency (below) pulls the newer, split org.osgi.annotation.bundle/versioning jars
      providing the identical classes - the same collision (and same fix)
      openworkflow-engine-pekko-quarkus already carries, just triggered by this module's own OSGi
      dependency instead of by Pekko.
    -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-quarkus-binding</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion><groupId>org.osgi</groupId><artifactId>osgi.annotation</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-config-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.annotation.bundle</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
            </goals>
          </execution>
          <!--
            Skipped: quarkusio/quarkus#7747 - Quarkus's TEST-mode bootstrap resolves dependencies
            via LocalProject, which re-reads reactor-sibling raw pom.xml (non-interpolating) instead
            of the properly-flattened, installed artifact. forwardmeasure-jpa-tenancy (reached here
            via openworkflow-quarkus-binding/openworkflow-authorization-api) hits this on its own
            ${revision} parent reference. Skipped repo-wide for generate-code-tests specifically
            (generate-code above, needed for real production augmentation, is untouched).
          -->
          <execution>
            <id>generate-code-tests</id>
            <goals>
              <goal>generate-code-tests</goal>
            </goals>
            <configuration>
              <skipSourceGeneration>true</skipSourceGeneration>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>container-image</id>
      <build>
        <plugins>
          <!--
          fabric8 docker-maven-plugin, not Quarkus's own quarkus-container-image-docker - same
          mechanism as every non-Quarkus openworkflow module (tenant-provisioning, migrations,
          spring/micronaut service bindings). Declared after quarkus-maven-plugin in this pom's
          own <build><plugins> (Maven appends a profile's <plugins> after the base build's, for
          same-phase executions) so this always builds from target/quarkus-app/ (produced by
          quarkus-maven-plugin's own build goal, also bound to the package phase) after Quarkus's
          augmentation has already run, not before it.
          -->
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <configuration>
              <images>
                <image>
                  <name>${container-image.registry}/${container-image.group}/${container-image.name}:${container-image.tag}</name>
                  <build>
                    <contextDir>${project.basedir}</contextDir>
                    <dockerFile>src/main/docker/Dockerfile.jvm</dockerFile>
                  </build>
                </image>
              </images>
            </configuration>
            <executions>
              <execution>
                <id>build-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>build</goal>
                </goals>
              </execution>
              <execution>
                <id>push-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>push</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>