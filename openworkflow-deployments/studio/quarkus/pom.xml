<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.forwardmeasure.openworkflow</groupId>
    <artifactId>forwardmeasure-openworkflow-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>
  <artifactId>openworkflow-studio-quarkus</artifactId>
  <name>ForwardMeasure OpenWorkflow :: Studio :: Quarkus</name>
  <properties>
    <container-image.name>openworkflow-studio-quarkus</container-image.name>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.forwardmeasure.platform</groupId>
        <artifactId>forwardmeasure-platform-quarkus-bom</artifactId>
        <version>${forwardmeasure.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-studio-webapp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-config-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.annotation.bundle</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.codehaus.plexus</groupId>
          <artifactId>plexus-utils</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>container-image</id>
      <build>
        <plugins>
          <!--
          fabric8 docker-maven-plugin, not Quarkus's own quarkus-container-image-docker - same
          mechanism as every non-Quarkus openworkflow module (tenant-provisioning, migrations,
          spring/micronaut service bindings). Declared after quarkus-maven-plugin in this pom's
          own <build><plugins> (Maven appends a profile's <plugins> after the base build's, for
          same-phase executions) so this always builds from target/quarkus-app/ (produced by
          quarkus-maven-plugin's own build goal, also bound to the package phase) after Quarkus's
          augmentation has already run, not before it.
          -->
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <configuration>
              <images>
                <image>
                  <name>${container-image.registry}/${container-image.group}/${container-image.name}:${container-image.tag}</name>
                  <build>
                    <contextDir>${project.basedir}</contextDir>
                    <dockerFile>src/main/docker/Dockerfile.jvm</dockerFile>
                  </build>
                </image>
              </images>
            </configuration>
            <executions>
              <execution>
                <id>build-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>build</goal>
                </goals>
              </execution>
              <execution>
                <id>push-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>push</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
