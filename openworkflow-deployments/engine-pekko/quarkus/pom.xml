<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.forwardmeasure.openworkflow</groupId>
    <artifactId>openworkflow-deployments</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>openworkflow-engine-pekko-quarkus</artifactId>
  <name>ForwardMeasure OpenWorkflow :: Engine Pekko :: Quarkus</name>

  <properties>
    <container-image.name>openworkflow-engine-pekko-quarkus</container-image.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-pekko-runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-pekko-persistence-core</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-pekko-persistence-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-pekko-persistence-cassandra</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-pekko-eventing-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-pekko-eventing-cassandra</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-pekko-eventing-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-pekko-eventing-jaxrs</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-pekko-eventing-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-engine-http</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-engine-http-server</artifactId>
    </dependency>
    <!-- Gives TenantScope/EntityManagerFactory (forwardmeasure-jpa-quarkus + quarkus-hibernate-orm),
         ActiveOrganizationProvider (QuarkusActiveOrganizationProvider), and AuthorizationService
         (openworkflow-authorization-authzen) - same shared module execution-management's own
         Quarkus service depends on, not duplicated piecemeal here.

         Excludes org.osgi:osgi.annotation: hibernate-jcache -> caffeine -> jcache pulls the old,
         combined 8.1.0 jar, while Pekko (only present on this module's classpath, unlike
         execution-management's own Quarkus service which doesn't have this exact collision) pulls
         the newer, split org.osgi.annotation.bundle/versioning jars providing the identical
         classes. Scoped to this dependency edge only, since other openworkflow-quarkus-binding
         consumers don't have Pekko on their classpath and don't hit this. -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-quarkus-binding</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion><groupId>org.osgi</groupId><artifactId>osgi.annotation</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-config-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.annotation.bundle</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
            </goals>
          </execution>
          <!--
            generate-code-tests split into its own execution, scoped skip only here (not on
            generate-code above, which production augmentation still needs): quarkusio/quarkus#7747
            - Quarkus's LocalProject re-reads reactor-sibling raw pom.xml via non-interpolating XML
            parsing during TEST-mode bootstrap. openworkflow-pekko-runtime's forwardmeasure-jpa-tenancy
            dependency (added for per-tenant Postgres journal schema isolation) reaches this module's
            reactor-sibling set for the first time and hits forwardmeasure-jpa-tenancy's own raw
            <parent><version>${revision}</version> - unresolvable, since only the flattened, already-
            installed pom (which LocalProject bypasses) has the real version. The previously-tried
            fix, quarkus.bootstrap.effective-model-builder=true, was reverted repo-wide as net
            negative (it trades this bug for a separate, worse Quarkus NPE in WorkspaceLoader.
            findVersions). This module has no @QuarkusTest classes (confirmed: none in src/test),
            so its own test-mode codegen is not actually needed - skipping it here is narrower and
            safer than the global property, and does not affect any other module's
            generate-code-tests execution.
          -->
          <execution>
            <id>generate-code-tests</id>
            <goals>
              <goal>generate-code-tests</goal>
            </goals>
            <configuration>
              <skipSourceGeneration>true</skipSourceGeneration>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>container-image</id>
      <build>
        <plugins>
          <!--
          fabric8 docker-maven-plugin, not Quarkus's own quarkus-container-image-docker - same
          mechanism as every non-Quarkus openworkflow module (tenant-provisioning, migrations,
          spring/micronaut service bindings). Declared after quarkus-maven-plugin in this pom's
          own <build><plugins> (Maven appends a profile's <plugins> after the base build's, for
          same-phase executions) so this always builds from target/quarkus-app/ (produced by
          quarkus-maven-plugin's own build goal, also bound to the package phase) after Quarkus's
          augmentation has already run, not before it.
          -->
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <configuration>
              <images>
                <image>
                  <name>${container-image.registry}/${container-image.group}/${container-image.name}:${container-image.tag}</name>
                  <build>
                    <contextDir>${project.basedir}</contextDir>
                    <dockerFile>src/main/docker/Dockerfile.jvm</dockerFile>
                  </build>
                </image>
              </images>
            </configuration>
            <executions>
              <execution>
                <id>build-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>build</goal>
                </goals>
              </execution>
              <execution>
                <id>push-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>push</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>