<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
   
    <parent>
        <groupId>com.forwardmeasure.openworkflow</groupId>
        <artifactId>openworkflow-deployments</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
   
    <artifactId>openworkflow-engine-pekko-spring</artifactId>
    <name>ForwardMeasure OpenWorkflow :: Engine Pekko :: Spring</name>
   
    <properties>
        <container-image.name>openworkflow-engine-pekko-spring</container-image.name>
    </properties>
  
    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>openworkflow-pekko-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>openworkflow-pekko-persistence-core</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>openworkflow-pekko-persistence-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>openworkflow-pekko-persistence-cassandra</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>openworkflow-pekko-eventing-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>openworkflow-pekko-eventing-cassandra</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>openworkflow-pekko-eventing-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>openworkflow-pekko-eventing-jaxrs</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>openworkflow-pekko-eventing-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>openworkflow-engine-http</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>openworkflow-engine-http-server</artifactId>
        </dependency>
        <!--
          Excludes two duplicate-class collisions duplicate-finder-maven-plugin flags as fatal,
          both only present here (not on execution-management's own Spring service, which lacks
          Pekko/an embedded servlet container on its classpath at the same time as these):
          - org.osgi:osgi.annotation: hibernate-jcache -> caffeine -> jcache pulls the old,
            combined 8.1.0 jar; Pekko pulls the newer, split org.osgi.annotation.bundle/versioning
            jars providing the identical classes.
          - jakarta.el:jakarta.el-api: hibernate-validator -> org.glassfish.expressly:expressly
            pulls the standalone EL API jar; Spring Boot's embedded Tomcat
            (org.apache.tomcat.embed:tomcat-embed-el) already bundles a complete, compatible EL
            implementation and API together - the standard Spring Boot fix for this exact,
            well-known collision.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>openworkflow-spring-binding</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion><groupId>org.osgi</groupId><artifactId>osgi.annotation</artifactId></exclusion>
                <exclusion><groupId>jakarta.el</groupId><artifactId>jakarta.el-api</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
          A second, independent source of the jakarta.el-api/tomcat-embed-el collision - separate
          from openworkflow-spring-binding's own edge (already excluded above). jakarta.enterprise
          cdi-api pulls jakarta.el-api transitively for its own EL-based bean resolution; Spring
          Boot's embedded Tomcat already provides a complete, compatible EL implementation.
        -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
            <exclusions>
                <exclusion><groupId>jakarta.el</groupId><artifactId>jakarta.el-api</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jersey</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.glassfish.hk2.external</groupId>
                    <artifactId>aopalliance-repackaged</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>container-image</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.fabric8</groupId>
                        <artifactId>docker-maven-plugin</artifactId>
                        <configuration>
                            <images>
                                <image>
                                    <name>
                                        ${container-image.registry}/${container-image.group}/${container-image.name}:${container-image.tag}</name>
                                    <build>
                                        <contextDir>${project.basedir}</contextDir>
                                        <dockerFile>src/main/docker/Dockerfile.jvm</dockerFile>
                                        <args>
                                            <APPLICATION_JAR>target/${project.build.finalName}.jar</APPLICATION_JAR>
                                            <BASE_IMAGE>${container-image.base-jre}</BASE_IMAGE>
                                        </args>
                                    </build>
                                </image>
                            </images>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-container-image</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>push-container-image</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>push</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>