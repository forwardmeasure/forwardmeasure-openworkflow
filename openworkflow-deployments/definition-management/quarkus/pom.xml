<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.forwardmeasure.openworkflow</groupId>
    <artifactId>forwardmeasure-openworkflow-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>
  <artifactId>openworkflow-definition-management-quarkus-service</artifactId>
  <name>ForwardMeasure OpenWorkflow :: Definition Management :: Quarkus Service</name>
  <properties>
    <container-image.name>openworkflow-definition-management-quarkus</container-image.name>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.forwardmeasure.platform</groupId>
        <artifactId>forwardmeasure-platform-quarkus-bom</artifactId>
        <version>${forwardmeasure.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-quarkus-binding</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-definition-management-quarkus</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <!--
    Enforces the @NotNull/@Pattern/@Valid annotations already present on every generated
    *Api interface's parameters (see openworkflow-api-specifications' required: true headers/
    fields) - without this extension those annotations are inert decoration, and a caller
    omitting a required header/field reaches business logic as a bare null instead of a 400.
    Confirmed missing the hard way: ETagSupport.parseIfMatch threw a raw NullPointerException
    on a missing If-Match header despite the generated interface already declaring
    @NotNull @Pattern(regexp="^\"[0-9]+\"$") on that exact parameter.
    -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-validator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-config-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-container-image-docker</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-authorization-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
    quarkus-junit's own exclusion below strips the old, colliding transitive plexus-utils copies -
    quarkus-bom itself excludes plexus-utils from several of its own managed dependencies for the
    same reason. This module's new @QuarkusTest + @QuarkusTestResource(KeycloakResource) test
    (AuthorizationSmokeQuarkusTest) actually exercises Quarkus's real Maven-resolver-based "curated
    application" bootstrap, exactly like openworkflow-operation-adapter-quarkus's own
    OperationAdapterQuarkusBindingTest - that bootstrap needs
    org.apache.maven.graph.DefaultGraphBuilder, which needs
    org.codehaus.plexus.util.dag.CycleDetectedException, a real plexus-utils class. Without this
    explicit re-add, plexus-utils is excluded from every path and the bootstrap fails with
    NoClassDefFoundError instead of ever starting the test. Pinned to 4.0.3, NOT the
    quarkus-bom-managed 3.6.1, for the same duplicate-finder-vs-plexus-xml reason documented on the
    operation-adapter-quarkus module's identical dependency.
    -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.codehaus.plexus</groupId>
          <artifactId>plexus-utils</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.codehaus.plexus</groupId>
      <artifactId>plexus-utils</artifactId>
      <version>4.0.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
            </goals>
          </execution>
          <!--
            Skipped: quarkusio/quarkus#7747 - Quarkus's TEST-mode bootstrap resolves dependencies
            via LocalProject, which re-reads reactor-sibling raw pom.xml (non-interpolating) instead
            of the properly-flattened, installed artifact. forwardmeasure-jpa-tenancy (reached here
            via openworkflow-quarkus-binding/openworkflow-authorization-api) hits this on its own
            ${revision} parent reference. Skipped repo-wide for generate-code-tests specifically
            (generate-code above, needed for real production augmentation, is untouched).
          -->
          <execution>
            <id>generate-code-tests</id>
            <goals>
              <goal>generate-code-tests</goal>
            </goals>
            <configuration>
              <skipSourceGeneration>true</skipSourceGeneration>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>container-image</id>
      <build>
        <plugins>
          <!--
          fabric8 docker-maven-plugin, not Quarkus's own quarkus-container-image-docker - same
          mechanism as every non-Quarkus openworkflow module (tenant-provisioning, migrations,
          spring/micronaut service bindings). Declared after quarkus-maven-plugin in this pom's
          own <build><plugins> (Maven appends a profile's <plugins> after the base build's, for
          same-phase executions) so this always builds from target/quarkus-app/ (produced by
          quarkus-maven-plugin's own build goal, also bound to the package phase) after Quarkus's
          augmentation has already run, not before it.
          -->
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <configuration>
              <images>
                <image>
                  <name>${container-image.registry}/${container-image.group}/${container-image.name}:${container-image.tag}</name>
                  <build>
                    <contextDir>${project.basedir}</contextDir>
                    <dockerFile>src/main/docker/Dockerfile.jvm</dockerFile>
                  </build>
                </image>
              </images>
            </configuration>
            <executions>
              <execution>
                <id>build-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>build</goal>
                </goals>
              </execution>
              <execution>
                <id>push-container-image</id>
                <phase>package</phase>
                <goals>
                  <goal>push</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
