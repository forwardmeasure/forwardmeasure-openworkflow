<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.forwardmeasure.openworkflow</groupId>
    <artifactId>forwardmeasure-openworkflow-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>
  <artifactId>openworkflow-definition-management-spring-service</artifactId>
  <name>ForwardMeasure OpenWorkflow :: Definition Management :: Spring Service</name>
  <properties><container-image.name>openworkflow-definition-management-spring</container-image.name></properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.forwardmeasure.platform</groupId>
        <artifactId>forwardmeasure-platform-spring-bom</artifactId>
        <version>${forwardmeasure.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>com.forwardmeasure.jpa</groupId>
      <artifactId>forwardmeasure-jpa-locking</artifactId>
    </dependency>
    <!--
    openworkflow-spring-binding's own forwardmeasure-jpa-spring dependency deliberately excludes
    forwardmeasure-jpa-async-task (and forwardmeasure-jpa-locking, re-added above), so this leaf
    must re-add it - confirmed missing the hard way, discovered by this module's first-ever full
    @SpringBootTest (AuthorizationSmokeSpringTest): without it, ANY Spring context refresh in this
    leaf (test or production) fails at boot with NoClassDefFoundError on
    com.forwardmeasure.jpa.asynctask.repository.AsyncTaskRepository - Spring's
    @ConditionalOnMissingBean evaluation for ForwardMeasureJpaAutoConfiguration.forwardMeasureTenantScope
    reflectively introspects every bean method on that auto-configuration class, including an
    unrelated one that references AsyncTaskRepository, so the whole class fails to load regardless
    of whether tenant-scope or async-task capability is actually used. The Micronaut sibling leaf
    already carries this same dependency for the same underlying reason.
    -->
    <dependency>
      <groupId>com.forwardmeasure.jpa</groupId>
      <artifactId>forwardmeasure-jpa-async-task</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-spring-binding</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-definition-management-spring</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>jakarta.enterprise.cdi-api</artifactId>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>jakarta.el</groupId>
          <artifactId>jakarta.el-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>openworkflow-authorization-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
    A full @SpringBootTest here boots the real production wiring, including every JPA-backed
    resource OpenWorkflowDefinitionManagementSpringBinding registers - not just
    AuthorizationSmokeResource, which has no persistence dependency of its own. Unlike Quarkus
    (which tolerates an unreachable datasource at boot and only fails lazily on first use), Spring
    Boot's HibernateJpaConfiguration eagerly builds the EntityManagerFactory during context
    refresh, which needs a real reachable connection to resolve the Hibernate dialect via JDBC
    metadata - confirmed missing the hard way ("Unable to determine Dialect without JDBC
    metadata") against the checked-in application.yaml's unreachable localhost:5432 default. A
    real, disposable Postgres testcontainer is a lighter, more honest fix than faking
    hibernate.dialect as a property: ddl-auto is none, so no schema/tables are needed for boot to
    succeed - the container only has to be reachable.
    -->
    <dependency>
      <groupId>com.forwardmeasure.testcontainers</groupId>
      <artifactId>forwardmeasure-testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
    This leaf previously had no JUnit5/Spring Boot test infrastructure at all (its only test class
    before AuthorizationSmokeSpringTest was none). spring-boot-starter-test is what actually
    supplies junit-jupiter, spring-boot-test (@SpringBootTest, @DynamicPropertySource,
    @LocalServerPort, @TestConfiguration), confirmed missing the hard way: test-compile failed with
    "package org.junit.jupiter.api does not exist" until this was added. See the sibling
    openworkflow-operation-adapter-spring module's identical dependency for the
    jsonassert/org.json duplicate-finder collision this module doesn't need to worry about (that
    collision is specific to modules pulling in com.ibm.mq via openworkflow-operation-adapter-kafka,
    which this module does not depend on).
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>container-image</id>
      <build>
        <plugins>
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <configuration>
              <images><image>
                <name>${container-image.registry}/${container-image.group}/${container-image.name}:${container-image.tag}</name>
                <build><contextDir>${project.basedir}</contextDir><dockerFile>src/main/docker/Dockerfile.jvm</dockerFile><args><APPLICATION_JAR>target/${project.build.finalName}.jar</APPLICATION_JAR><BASE_IMAGE>${container-image.base-jre}</BASE_IMAGE></args></build>
              </image></images>
            </configuration>
            <executions>
              <execution>
                <id>build-container-image</id>
                <phase>package</phase>
                <goals><goal>build</goal></goals>
              </execution>
              <execution><id>push-container-image</id><phase>package</phase><goals><goal>push</goal></goals></execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
