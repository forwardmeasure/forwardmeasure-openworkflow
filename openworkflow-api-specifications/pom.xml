<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.forwardmeasure.openworkflow</groupId>
        <artifactId>forwardmeasure-openworkflow-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>openworkflow-api-specifications</artifactId>
    <packaging>jar</packaging>

    <name>ForwardMeasure OpenWorkflow :: API Specifications</name>
    <description>Canonical OpenAPI 3.1 source for openworkflow-definition-management and
        openworkflow-execution-management. Consumers depend on this module (provided scope) and
        unpack META-INF/openapi/** at build time rather than reading the spec files from a raw
        filesystem path.</description>
    <build>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <executions>
            <execution>
              <id>early-package-api-specifications</id>
              <phase>process-resources</phase>
              <goals>
                <goal>jar</goal>
              </goals>
              <configuration>
                <classifier>early</classifier>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </build>
</project>
