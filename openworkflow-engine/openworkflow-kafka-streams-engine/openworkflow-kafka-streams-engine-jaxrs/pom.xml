<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.forwardmeasure.openworkflow</groupId>
        <artifactId>openworkflow-kafka-streams-engine-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>openworkflow-kafka-streams-engine-jaxrs</artifactId>
    <name>ForwardMeasure OpenWorkflow :: Kafka Streams :: Engine JAX-RS</name>

    <!--
    Mirrors openworkflow-pekko-eventing-jaxrs's role for the Pekko engine: the JAX-RS-specific
    CloudEvents HTTP ingress lives in its own module, separate from openworkflow-kafka-streams-engine
    (the Kafka Streams topology/runtime, which stays free of a JAX-RS dependency, same as
    openworkflow-pekko-eventing-core stays free of one).
    -->
    <dependencies>
        <dependency>
            <groupId>com.forwardmeasure.openworkflow</groupId>
            <artifactId>openworkflow-kafka-streams-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>com.forwardmeasure.openworkflow</groupId>
            <artifactId>openworkflow-kafka-streams-runtime-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.forwardmeasure.openworkflow</groupId>
            <artifactId>openworkflow-authorization-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.forwardmeasure.openworkflow</groupId>
            <artifactId>openworkflow-common-models</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
        kafka-clients (KafkaConsumer/ProducerRecord/etc.) is not declared explicitly - it already
        arrives transitively via openworkflow-kafka-streams-engine's own kafka-streams dependency,
        same as that module's own tests rely on.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-redpanda</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
