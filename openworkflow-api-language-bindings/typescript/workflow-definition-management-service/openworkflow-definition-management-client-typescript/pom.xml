<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>com.forwardmeasure.openworkflow</groupId><artifactId>forwardmeasure-openworkflow-parent</artifactId><version>${revision}</version><relativePath>../../../../pom.xml</relativePath></parent>
    <artifactId>openworkflow-definition-management-client-typescript</artifactId>
    <name>ForwardMeasure OpenWorkflow :: Definition Management :: Generated TypeScript Client</name>
    <dependencies>
        <!--
        Needed as a real Maven dependency (not just the unpack goal's <artifactItems> below) so the
        reactor's own build-order sorter knows to build openworkflow-api-specifications first.
        Without this, <artifactItems> alone is invisible to reactor ordering - Maven only reads real
        <dependency> entries (and a few other well-known places) to compute build order, never
        arbitrary plugin configuration. provided scope: this module only unpacks the spec's
        resources at build time, nothing here compiles against or should transitively carry a real
        runtime dependency on it.
        -->
        <dependency><groupId>${project.groupId}</groupId><artifactId>openworkflow-api-specifications</artifactId><version>${project.version}</version>
                                    <classifier>early</classifier><scope>provided</scope></dependency>
    </dependencies>
    <build><resources><resource><directory>${project.build.directory}/generated-typescript</directory><targetPath>typescript-client</targetPath><excludes><exclude>.openapi-generator/**</exclude></excludes></resource></resources><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><executions><execution><id>unpack-openapi-spec</id><phase>generate-resources</phase><goals><goal>unpack</goal></goals><configuration><artifactItems><artifactItem><groupId>${project.groupId}</groupId><artifactId>openworkflow-api-specifications</artifactId><version>${project.version}</version>
                                    <classifier>early</classifier><type>jar</type><includes>META-INF/openapi/**</includes><outputDirectory>${project.build.directory}/unpacked-openapi-spec</outputDirectory></artifactItem></artifactItems></configuration></execution></executions></plugin><plugin><groupId>org.openapitools</groupId><artifactId>openapi-generator-maven-plugin</artifactId><executions><execution><id>generate-typescript</id><phase>generate-resources</phase><goals><goal>generate</goal></goals><configuration>
        <inputSpec>${project.build.directory}/unpacked-openapi-spec/META-INF/openapi/definition-management.openapi.yaml</inputSpec><generatorName>typescript-fetch</generatorName><templateDirectory>${project.basedir}/../../../../config/openapi/templates/typescript-fetch</templateDirectory><output>${project.build.directory}/generated-typescript</output><generateApiTests>false</generateApiTests><generateModelTests>false</generateModelTests><generateApiDocumentation>false</generateApiDocumentation><generateModelDocumentation>false</generateModelDocumentation><skipValidateSpec>false</skipValidateSpec><additionalProperties><additionalProperty>packageAsSourceOnlyLibrary=true</additionalProperty></additionalProperties><configOptions><npmName>@forwardmeasure/openworkflow-definition-management-client</npmName><npmVersion>1.0.0</npmVersion><prefixParameterInterfaces>true</prefixParameterInterfaces><supportsES6>true</supportsES6><useSingleRequestParameter>true</useSingleRequestParameter><withInterfaces>true</withInterfaces></configOptions>
    </configuration></execution></executions></plugin></plugins></build>
</project>
