        <createSequence sequenceName="workflow_definition_id_seq" startValue="1" incrementBy="50"/>
        <createSequence sequenceName="workflow_review_id_seq" startValue="1" incrementBy="50"/>
        <createSequence sequenceName="workflow_publication_id_seq" startValue="1" incrementBy="50"/>
        <createSequence sequenceName="workflow_lifecycle_history_id_seq" startValue="1" incrementBy="50"/>
