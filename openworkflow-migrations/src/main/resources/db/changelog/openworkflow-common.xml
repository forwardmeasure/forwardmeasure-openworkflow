    <changeSet id="openworkflow-170-align-pooled-id-sequences" author="forwardmeasure" dbms="postgresql">
        <comment>Align sequence high values with Hibernate's allocationSize=50 across multiple service JVMs.</comment>
        <sql splitStatements="false"><![CDATA[
            DO $$
            DECLARE
                sequence_table text;
                maximum_id bigint;
                next_high bigint;
            BEGIN
                FOREACH sequence_table IN ARRAY ARRAY[
                    'workflow',
                    'workflow_definition',
                    'workflow_review',
                    'workflow_publication',
                    'workflow_lifecycle_history'
                ] LOOP
                    EXECUTE format('SELECT coalesce(max(id), 0) FROM %I', sequence_table)
                        INTO maximum_id;
                    IF maximum_id = 0 THEN
                        next_high := 50;
                    ELSE
                        next_high := ((maximum_id / 50) + 2) * 50;
                    END IF;
                    PERFORM setval(sequence_table || '_id_seq', next_high, false);
                END LOOP;
            END;
            $$;
        ]]></sql>
    </changeSet>

