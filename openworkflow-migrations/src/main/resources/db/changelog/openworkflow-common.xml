    <changeSet id="openworkflow-121-immutable-workflow-definition" author="forwardmeasure" dbms="postgresql">
        <comment>Identity (workflow_id, revision_number) and authorship (author_actor_id) are immutable at every
            lifecycle state, including DRAFT. All other content is mutable while DRAFT and immutable from the
            moment a definition leaves DRAFT.</comment>
        <sql splitStatements="false"><![CDATA[
            CREATE OR REPLACE FUNCTION prevent_workflow_definition_content_update()
            RETURNS trigger LANGUAGE plpgsql AS $$
            BEGIN
                IF NEW.workflow_id IS DISTINCT FROM OLD.workflow_id
                   OR NEW.revision_number IS DISTINCT FROM OLD.revision_number
                   OR NEW.author_actor_id IS DISTINCT FROM OLD.author_actor_id THEN
                    RAISE EXCEPTION 'workflow definition identity and authorship are immutable';
                END IF;
                IF OLD.lifecycle_state <> 'DRAFT' AND (
                   NEW.source_document IS DISTINCT FROM OLD.source_document
                   OR NEW.resolved_document IS DISTINCT FROM OLD.resolved_document
                   OR NEW.resolved_resources IS DISTINCT FROM OLD.resolved_resources
                   OR NEW.namespace IS DISTINCT FROM OLD.namespace
                   OR NEW.document_version IS DISTINCT FROM OLD.document_version
                   OR NEW.specification_version IS DISTINCT FROM OLD.specification_version
                   OR NEW.compiler_profile IS DISTINCT FROM OLD.compiler_profile
                   OR NEW.source_digest IS DISTINCT FROM OLD.source_digest
                   OR NEW.resolved_digest IS DISTINCT FROM OLD.resolved_digest
                ) THEN
                    RAISE EXCEPTION 'workflow definition content is immutable once submitted for review';
                END IF;
                RETURN NEW;
            END;
            $$;
            CREATE TRIGGER workflow_definition_content_immutable
            BEFORE UPDATE ON workflow_definition
            FOR EACH ROW EXECUTE FUNCTION prevent_workflow_definition_content_update();
        ]]></sql>
    </changeSet>

