    <changeSet id="openworkflow-251-advance-definition-sequences" author="forwardmeasure" dbms="postgresql">
        <comment>Advance upgraded tenant sequences beyond identifiers allocated by earlier pooled generators.</comment>
        <sql splitStatements="true"><![CDATA[
            SELECT setval('workflow_definition_id_seq',
              GREATEST(COALESCE((SELECT MAX(id) FROM workflow_definition), 0) + 1, 1), false);
            SELECT setval('workflow_revision_id_seq',
              GREATEST(COALESCE((SELECT MAX(id) FROM workflow_revision), 0) + 1, 1), false);
        ]]></sql>
    </changeSet>

