    <changeSet id="openworkflow-270-immutable-definition-resource-bundle" author="forwardmeasure" dbms="postgresql">
        <comment>Retain the exact publication-time external resource bytes required for deterministic execution and recovery.</comment>
        <addColumn tableName="workflow_revision">
            <column name="resolved_resources" type="TEXT" defaultValue="[]"><constraints nullable="false"/></column>
        </addColumn>
        <dropDefaultValue tableName="workflow_revision" columnName="resolved_resources"/>
        <sql splitStatements="false"><![CDATA[
            CREATE OR REPLACE FUNCTION prevent_workflow_revision_content_update()
            RETURNS trigger LANGUAGE plpgsql AS $$
            BEGIN
                IF NEW.definition_id IS DISTINCT FROM OLD.definition_id
                   OR NEW.revision_number IS DISTINCT FROM OLD.revision_number
                   OR NEW.source_document IS DISTINCT FROM OLD.source_document
                   OR NEW.resolved_document IS DISTINCT FROM OLD.resolved_document
                   OR NEW.resolved_resources IS DISTINCT FROM OLD.resolved_resources
                   OR NEW.specification_version IS DISTINCT FROM OLD.specification_version
                   OR NEW.compiler_profile IS DISTINCT FROM OLD.compiler_profile
                   OR NEW.source_digest IS DISTINCT FROM OLD.source_digest
                   OR NEW.resolved_digest IS DISTINCT FROM OLD.resolved_digest
                   OR NEW.author_actor_id IS DISTINCT FROM OLD.author_actor_id THEN
                    RAISE EXCEPTION 'workflow revision content is immutable';
                END IF;
                RETURN NEW;
            END;
            $$;
        ]]></sql>
    </changeSet>
</databaseChangeLog>
